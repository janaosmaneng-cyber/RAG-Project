# Virtual environment
.venv/                    # Ignore the project's Python virtual environment
venv/                     # Ignore a virtual environment named "venv"

# Python
__pycache__/              # Ignore Python's automatically generated cache folders
*.py[cod]                 # Ignore Python's compiled/temporary files (.pyc, .pyo, .pyd)

# Environment variables
.env                      # Ignore the local .env file, which may contain secrets or private configuration

# Logs
*.log                     # Ignore all log files generated by the application

# Jupyter
.ipynb_checkpoints/       # Ignore Jupyter Notebook's automatically generated checkpoint files

# Raw documents
data/documents/*          # Ignore all raw documents, such as the large PDF used as the RAG source
!data/documents/.gitkeep  # Keep the .gitkeep file so Git tracks the otherwise empty folder

# Chroma/vector database
vector_store/*            # Ignore all generated Chroma vector database files
!vector_store/.gitkeep    # Keep the .gitkeep file so Git tracks the otherwise empty folder